# SSLCommerz (sandbox by default) - powers both Subscription Management
# (plan upgrade payments) and parent/student online fee payments.
# testbox/qwerty below are SSLCommerz's own public sandbox demo
# credentials (https://developer.sslcommerz.com) - they work out of the box
# for local testing with the sandbox card/mobile-wallet numbers on that
# same docs page. Swap in your own sandbox store to see it under your own
# name, and a live store_id/store_passwd (with SSLCOMMERZ_IS_LIVE=true)
# before taking real payments.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false

# Base URL of this backend, used to build SSLCommerz success/fail/cancel/IPN
# callback URLs (must be publicly reachable by SSLCommerz in production).
SERVER_URL=http://localhost:5000
